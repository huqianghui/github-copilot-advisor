# .env.example — 复制为 .env 并填入真实值(.env 已在 .gitignore)
GITHUB_TOKEN=ghp_xxx
AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
AZURE_SEARCH_AUTH_MODE=key
AZURE_SEARCH_API_KEY=xxx
AZURE_SEARCH_INDEX=copilot-qa
AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com
AZURE_OPENAI_AUTH_MODE=key
AZURE_OPENAI_API_KEY=xxx
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat-deployment-name>
# 在线检索的 embedding 部署名;模型和维度需与已有索引相容。
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Azure 依赖分别显式选择 key/entra;Entra 失败不会回退到旧 Key。
# 本地 Entra 使用 az login 的 AzureCliCredential;云端改为 managed_identity,
# 并设置选定用户分配托管身份的 AZURE_CLIENT_ID(不使用隐式凭据链)。
# AZURE_OPENAI_AD_TOKEN 不参与认证选择;OpenAI/Search 默认仍为 key。
# 本次跨租户云实验明确使用 Key 访问原模型/Search;部署计划覆盖认证模式,
# 不覆盖本地 Bot 配置。新建 Storage/Bot/压测身份仍使用新租户托管身份。
# 仅部署计划使用: AZURE_SUBSCRIPTION_ID=18827cdf-a4e8-4316-a7ba-a4499139a3ec
# ACA 云端构建在部署计划设置 ACA_BUILD_MODE=acr,无需本地 Docker 引擎。
ADVISOR_ENTRA_CREDENTIAL=azure_cli
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# 本地 memory 会话无需 Storage 配置;云存储地址必须 HTTPS(本机 loopback 可用 HTTP)。
ADVISOR_STORAGE_AUTH_MODE=entra
# ADVISOR_BLOB_SERVICE_URL=https://<account>.blob.core.windows.net
# ADVISOR_QUEUE_SERVICE_URL=https://<account>.queue.core.windows.net
# Storage key 模式还必须提供以下两项;不要将 SAS/Key 放进服务 URL。
# ADVISOR_STORAGE_ACCOUNT_NAME=<account>
# ADVISOR_STORAGE_ACCOUNT_KEY=<account-key>
# 原本地启动默认 direct + 内存历史;部署脚本为云宿主设置 queued + Blob/Queue。
# 不需要为本地联调配置持久存储,也不要将云 Bot 身份覆盖到下面的本地 Bot。
# 每条历史保存 30 天,模型只看当前租户/会话/用户最近 20 条;内存模式重启即丢失。
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=00000000-0000-0000-0000-000000000000
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=xxx
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=00000000-0000-0000-0000-000000000000
# 本地/emulator 联调可放开匿名(生产勿开):
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=True
TAVILY_API_KEY=tvly-xxx
BRAVE_API_KEY=
# KB 与 GitHub 同时启动,独立等待预算;GitHub 的实际预算不超过 KB 预算。
# KB 预算包含 embedding + Azure Search + 本地过滤。
KB_SEARCH_BUDGET_SECONDS=12
GITHUB_SEARCH_BUDGET_SECONDS=4
# 单次逻辑 Web 检索:双范围共享等待预算,每个 provider 尝试有独立上限。
WEB_SEARCH_BUDGET_SECONDS=12
WEB_SEARCH_ATTEMPT_TIMEOUT_SECONDS=6
ESCALATION_CONFIG=agent/escalation.yaml
# 应用日志:DEBUG / INFO / WARNING / ERROR / CRITICAL;默认 INFO。
# DEBUG 才采集 LLM HTTP 尝试、重试/传输阶段及安全响应元数据;无需 OPENAI_LOG。
ADVISOR_LOG_LEVEL=INFO
# json 便于收集分析,text 便于本地阅读;默认 json。
ADVISOR_LOG_FORMAT=json
# 实验入口默认关闭;启用需独立 Entra API、调用者白名单、固定回调和批准的数据集。
# 不能复用 Bot JWT 或把测试会话发到真实 Teams。
BENCHMARK_ENABLED=false
