{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "concurrency": {"dynamicConcurrencyEnabled": false},
  "extensions": {
    "http": {"routePrefix": ""},
    "queues": {
      "messageEncoding": "none",
      "batchSize": 4,
      "newBatchThreshold": 0,
      "maxPollingInterval": "00:00:02",
      "visibilityTimeout": "00:00:30",
      "maxDequeueCount": 5
    }
  }
}
